{
  "name": "matterbridge-dreame-fp10",
  "version": "0.1.2",
  "description": "Matterbridge plugin for the Dreame FP10 air purifier.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "matterbridge-dreame-fp10.config.json",
    "matterbridge-dreame-fp10.schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -w -p tsconfig.json",
    "clean": "rm -rf dist",
    "dev:link": "npm link matterbridge",
    "matterbridge:add": "matterbridge -add .",
    "matterbridge:remove": "matterbridge -remove .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "matterbridge",
    "matter",
    "air-purifier",
    "dreame",
    "fp10"
  ],
  "author": "iblur01",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.9.3"
  }
}
